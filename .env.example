# Example environment for monzo-mcp. Copy to `.env` (git-ignored) or set these in your shell.
# The server does not load `.env` by itself: export the variables, or let your MCP client pass them.
# Never commit real values. Only the first two are required.

# --- Required: your own OAuth client from https://developers.monzo.com (Confidential) ---
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# --- OAuth helper (monzo-mcp-authorize) ---
# MONZO_REDIRECT_URI=http://localhost:8765/callback

# --- Token storage ---
# MONZO_TOKEN_FILE=~/.monzo-mcp/tokens.json
# package.module:factory for a custom token store. Imports and runs that code.
# MONZO_TOKEN_STORE=
# Seed tokens, read only while the token store is empty. These are secrets.
# MONZO_REFRESH_TOKEN=
# MONZO_ACCESS_TOKEN=

# --- Tools ---
# MONZO_MAX_RANGE_DAYS=400

# --- Transport ---
# MONZO_MCP_TRANSPORT=stdio
# MONZO_MCP_HOST=127.0.0.1
# MONZO_MCP_PORT=8000
# MONZO_MCP_PATH=/mcp
# Bearer token HTTP clients must send. Required for a non-loopback bind.
# MONZO_MCP_AUTH_TOKEN=
# Set to 1 only behind an authenticating gateway.
# MONZO_MCP_ALLOW_NO_AUTH=
# Comma-separated public host names accepted in the Host header (behind a proxy or tunnel).
# MONZO_MCP_ALLOWED_HOSTS=
# MONZO_MCP_LOG_LEVEL=INFO

# --- Test hook: leave unset ---
# MONZO_API_BASE=
